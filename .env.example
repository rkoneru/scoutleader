# Optional. With these unset the app runs local-first: bundled scenarios,
# profile and attempts stored on the device, no account.
#
# Set both to turn on troop accounts and sync. Copy to `.env` — Expo loads
# EXPO_PUBLIC_* variables into the client bundle automatically.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
